@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# tags_a + tags_b under priority (tags_b higher): two conflicts, both won by tags_b.
# rdflib holds "Colour"@en-GB and "Colour"@EN-gb as one term, so ex:T has it once.
ex:T rdfs:label "Colour"@en-GB, "Name", "Nom"@fr .
ex:U rdfs:label "Color"@en-gb .
ex:V rdfs:label "Two" .
