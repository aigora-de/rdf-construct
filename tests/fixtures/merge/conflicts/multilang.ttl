@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# #193: one correctly multilingual file. Alone or merged with itself it has no conflict.
ex:Building a owl:Class ;
    rdfs:label "Building"@en, "Bâtiment"@fr, "Gebäude"@de ;
    rdfs:comment "A structure."@en, "Une structure."@fr ;
    skos:altLabel "Structure"@en, "Edifice"@en .
