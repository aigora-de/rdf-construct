@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Language tags are compared without case, and an untagged literal is its own bucket.
# ex:T: "Colour"@en-GB here and "Colour"@EN-gb in tags_b are one value, so no conflict.
# ex:U: "Colour"@en-GB here and "Color"@en-gb in tags_b conflict within one tag.
# ex:V: two untagged labels conflict; an untagged and a tagged label do not (ex:T).
ex:T rdfs:label "Colour"@en-GB, "Name" .
ex:U rdfs:label "Colour"@en-GB .
ex:V rdfs:label "One" .
