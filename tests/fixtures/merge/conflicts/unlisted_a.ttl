@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# A predicate the tier map does not list is repeatable: a second superclass, type, example
# or title is another assertion, not a conflict.
ex:Hall a owl:Class ; rdfs:subClassOf ex:Room ; skos:example "Assembly hall"@en ;
    dcterms:title "Hall"@en .
