@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Three sources disagree on the English label and agree on the French one.
# Merged as a, b, c with -p 1 -p 3 -p 2, each strategy keeps a different English label.
ex:Thing a owl:Class ;
    rdfs:label "Alpha"@en, "Chose"@fr ;
    rdfs:comment "Said by a."@en .
