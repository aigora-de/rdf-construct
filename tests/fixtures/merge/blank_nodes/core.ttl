# Blank-node structures for merge (#170). Merged with module.ttl, the result must be
# merged.expected.ttl: a structure both files state is written once, and every other is kept.

@prefix ex: <http://example.org/bn#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:pA a owl:ObjectProperty .
ex:pZ a owl:ObjectProperty .
ex:B a owl:Class .
ex:C a owl:Class .

# In module.ttl too, under the same subject and predicate: written once.
ex:A a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty ex:pA ;
        owl:someValuesFrom ex:B ] .

# A restriction nesting a list, in module.ttl too: written once.
ex:N rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty ex:pA ;
        owl:someValuesFrom [ owl:unionOf ( ex:B ex:C ) ] ] .

# An rdf:List, in module.ttl too: written once.
ex:U owl:unionOf ( ex:B ex:C ) .

# A root blank node, in module.ttl too: written once.
[] a owl:AllDisjointClasses ;
    owl:members ( ex:A ex:B ex:C ) .

# One person known by two people, in module.ttl too: written once.
ex:alice foaf:knows _:bob .
ex:carol foaf:knows _:bob .
_:bob foaf:name "Bob" .

# module.ttl says someone called Eve is known by ex:frank. Nothing says it is the same Eve.
ex:dave foaf:knows [ foaf:name "Eve" ] .

# Stated twice here and once in module.ttl: the merge keeps both of this file's copies.
ex:D rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty ex:pA ;
        owl:someValuesFrom ex:C ],
    [ a owl:Restriction ;
        owl:onProperty ex:pA ;
        owl:someValuesFrom ex:C ] .

# module.ttl annotates this restriction, so the two are different structures: both are kept.
ex:E rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty ex:pZ ;
        owl:someValuesFrom ex:B ] .

# module.ttl lists these the other way round. RDF lists are ordered: both are kept.
ex:V owl:unionOf ( ex:B ex:C ) .
