@prefix unmatched: <http://example.org/unmatched#> .
@prefix ex: <http://example.org/ex#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# #382: a namespace module that takes the unmatched module's default name, plus residue

unmatched:A a owl:Class .
ex:B a owl:Class .
ex:untyped rdfs:label "residue" .
