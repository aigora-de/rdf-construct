@prefix ex: <http://example.org/ex#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# #383's file: four declarations of other vocabularies' terms, as Protégé writes them

<http://example.org/ex> a owl:Ontology ; dcterms:title "Ex" .
ex:Thing a owl:Class ; rdfs:label "Thing" ; dcterms:title "t" ; skos:prefLabel "Thing" .
rdfs:label a owl:AnnotationProperty .
dcterms:title a owl:AnnotationProperty .
skos:prefLabel a owl:AnnotationProperty .
owl:Thing a owl:Class .
