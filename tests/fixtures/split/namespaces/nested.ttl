# The IES shape in miniature: env: is a prefix of building: and blg-class:, and is declared first,
# so the first namespace to match would claim everything. The longest one must.
# env/x/Y sits under env: in a path nobody declared, and stays with env.
@prefix env: <http://example.org/ies/env/> .
@prefix building: <http://example.org/ies/env/building/> .
@prefix blg-class: <http://example.org/ies/env/building-classification/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

env:EnvironmentalThing a owl:Class .

<http://example.org/ies/env/x/Y> a owl:Class ;
    rdfs:subClassOf env:EnvironmentalThing .

building:Building a owl:Class ;
    rdfs:subClassOf env:EnvironmentalThing .

building:hasStorey a owl:ObjectProperty ;
    rdfs:domain building:Building .

blg-class:ClassOfDetachedHouse a owl:Class ;
    rdfs:subClassOf building:Building .

blg-class:ClassOfTerrace a owl:Class ;
    rdfs:subClassOf building:Building .
