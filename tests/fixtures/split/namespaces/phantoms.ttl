# Declares one namespace with subjects and one without. rdflib's default table binds about thirty
# more (brick, doap, geo, schema, void, ...); none of them, and not unused:, may become a module.
@prefix ex: <http://example.org/phantoms#> .
@prefix unused: <http://example.org/unused#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Widget a owl:Class ;
    rdfs:label "Widget"@en .

ex:partOf a owl:ObjectProperty ;
    rdfs:domain ex:Widget .
