@prefix bld: <http://example.org/building#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# A small ontology for the DIFF_GUIDE.md worked examples: version 2.
#
# It differs from v1.ttl ONLY inside blank nodes, the shape a diff most easily gets
# wrong in both directions (#143):
#
# - the restriction on bld:Building changed its cardinality;
# - the owl:Axiom annotating bld:Room's subclass axiom changed its comment;
# - the owl:AllDisjointClasses gained a member. Nothing names it, so it has no owner.
#
# The restriction on bld:Room and the owl:unionOf on bld:Space do not change, so
# a diff that cannot match blank nodes reports them, and one that matches them
# does not. Every named triple is the same in both files: a diff that skips blank
# nodes reports nothing at all.

<http://example.org/building>
    a owl:Ontology ;
    rdfs:label "Building Ontology"@en .

bld:Building
    a owl:Class ;
    rdfs:label "Building"@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty bld:hasFloor ;
        owl:minCardinality "2"^^xsd:nonNegativeInteger
    ] .

bld:Floor
    a owl:Class ;
    rdfs:label "Floor"@en .

bld:Room
    a owl:Class ;
    rdfs:label "Room"@en ;
    rdfs:subClassOf bld:Space ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty bld:onFloor ;
        owl:someValuesFrom bld:Floor
    ] .

bld:Door
    a owl:Class ;
    rdfs:label "Door"@en .

bld:Space
    a owl:Class ;
    rdfs:label "Space"@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:unionOf ( bld:Room bld:Floor )
    ] .

bld:hasFloor
    a owl:ObjectProperty ;
    rdfs:label "has floor"@en ;
    rdfs:domain bld:Building ;
    rdfs:range bld:Floor .

bld:onFloor
    a owl:ObjectProperty ;
    rdfs:label "on floor"@en ;
    rdfs:domain bld:Room ;
    rdfs:range bld:Floor .

[] a owl:Axiom ;
    owl:annotatedSource bld:Room ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedTarget bld:Space ;
    rdfs:comment "A room is an enclosed space."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( bld:Building bld:Door bld:Floor bld:Room ) .
